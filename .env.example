# MultiDesktopFlow Environment Configuration
# Copy this file to .env and fill in your values
#
# IMPORTANT: Variables MUST be prefixed with VITE_ to be exposed to the client
# Get your credentials from: https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api

# Supabase URL (Project URL)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anon Key (public, safe for frontend)
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Note: Service role key should NEVER be in frontend code
# Use it only in backend/server-side code
